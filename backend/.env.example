# Copy to .env and fill in for local development.
# All variables are loaded via pydantic-settings (see src/wellness/config.py).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres — matches docker-compose.yml service "db"
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy connection string built from the above at runtime, or override directly:
DATABASE_URL=postgresql+asyncpg://wellness:wellness@localhost:5432/wellness

# Redis — matches docker-compose.yml service "redis"
REDIS_URL=redis://localhost:6379/0

# Required — the app fails to start without this (see config.py). No default
# is shipped here on purpose: a placeholder value is exactly the kind of
# thing that accidentally reaches production. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the dev frontend runs — CORS is scoped to exactly this origin.
FRONTEND_ORIGIN=http://localhost:5173

# Optional — only needed to run scripts/mood_spend_correlation.py's AI report
# step. Same Pydantic AI Gateway key used in the game-store project.
API_KEY_SECRET_FROM_EURISKO=
