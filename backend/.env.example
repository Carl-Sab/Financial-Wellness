# Copy to .env and fill in for local development.
# All variables are loaded via pydantic-settings (see src/wellness/config.py).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres — matches docker-compose.yml service "db"
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy connection string built from the above at runtime, or override directly:
DATABASE_URL=postgresql+asyncpg://wellness:wellness@localhost:5432/wellness

# Redis — matches docker-compose.yml service "redis"
REDIS_URL=redis://localhost:6379/0

# Required — the app fails to start without this (see config.py). No default
# is shipped here on purpose: a placeholder value is exactly the kind of
# thing that accidentally reaches production. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the dev frontend runs — CORS is scoped to exactly this origin.
FRONTEND_ORIGIN=http://localhost:5173

# Optional — enables AI wording for the statistics relationship summary and
# the standalone report script. The API safely falls back to local wording.
API_KEY_SECRET_FROM_EURISKO=

# Optional — SMTP for check-in overspending-risk emails. Without a host,
# notifications are still recorded in notification_outbox but marked
# "suppressed" instead of sent. For Gmail: smtp.gmail.com, port 587, and an
# App Password (not your account password) as SMTP_PASSWORD.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
