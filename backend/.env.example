# Copy to .env and fill in for local development.
# All variables are loaded via pydantic-settings (see src/wellness/config.py).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres — matches docker-compose.yml service "db"
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy connection string built from the above at runtime, or override directly:
DATABASE_URL=postgresql+asyncpg://wellness:wellness@localhost:5432/wellness

# Redis — matches docker-compose.yml service "redis"
REDIS_URL=redis://localhost:6379/0

# Optional — only needed to run scripts/mood_spend_correlation.py's AI report
# step. Same Pydantic AI Gateway key used in the game-store project.
API_KEY_SECRET_FROM_EURISKO=pylf_v2_us_4610e8b8-7f5f-435c-89c1-b23f9a1c5f15_sx9mTY89P1bsMKz2PfYPvtDpWyQ8HvDVk2z0cQ4zKV94
