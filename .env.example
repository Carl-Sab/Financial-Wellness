# Copy this file to .env before starting the Compose stack.
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_PORT=5432

BACKEND_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO

# Required. Replace this with a long random value before starting the app.
JWT_SECRET=replace-with-a-long-random-development-secret

# Optional: enables AI wording for the statistics relationship summary.
# Without it, the same verified patterns use a deterministic local summary.
API_KEY_SECRET_FROM_EURISKO=

# Optional: SMTP for check-in overspending-risk emails. Without a host,
# notifications are recorded but not sent. For Gmail: smtp.gmail.com, port
# 587, and an App Password (not your account password) as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=michelsamrani@gmail.com
SMTP_PASSWORD=pqjpqjmdykqhujsx
SMTP_FROM_EMAIL=michelsamrani@gmail.com
SMTP_USE_TLS=true

