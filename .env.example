# Copy this file to .env before starting the Compose stack.
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_PORT=5432

BACKEND_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO

# Required. Replace this with a long random value before starting the app.
JWT_SECRET=replace-with-a-long-random-development-secret

# Optional: enables AI wording for the statistics relationship summary.
# Without it, the same verified patterns use a deterministic local summary.
API_KEY_SECRET_FROM_EURISKO=
